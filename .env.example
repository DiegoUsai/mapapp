# Database Postgres (Vercel Postgres / Neon). DATABASE_URL usa il pooler, DIRECT_URL la connessione diretta per le migrazioni.
DATABASE_URL="postgres://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js (NextAuth v5)
# AUTH_URL è opzionale su Vercel (rilevato in automatico). AUTH_SECRET è obbligatorio.
AUTH_SECRET="genera-con-npx-auth-secret-oppure-openssl-rand-base64-32"

# OAuth Google (Google Cloud Console → Credenziali → ID client OAuth)
# In v5 i nomi AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET sono riconosciuti automaticamente,
# ma qui usiamo i nomi espliciti letti dal codice.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dominio email autorizzato ad accedere (separare con virgola per più domini)
ALLOWED_EMAIL_DOMAINS="aicof.it"

# PostHog — analytics (progetto EU)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
